#!/bin/sh
# git pre-commit 钩子：提交前自动格式化 Rust 代码并校验
#
# 通过 `make install-hooks` 设置 `core.hooksPath` 指向本目录后生效。
# 仅做格式检查（fast path，不拖慢提交）；clippy / test 交由 `make verify` 与 CI。

set -e

echo "==> [pre-commit] cargo fmt --all（自动格式化）"
cargo fmt --all

echo "==> [pre-commit] git add -u（重新暂存格式化差异）"
git add -u

echo "==> [pre-commit] cargo fmt --all -- --check（校验）"
cargo fmt --all -- --check

echo "==> [pre-commit] 格式检查通过"